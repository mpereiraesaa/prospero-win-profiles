; Prince of Persia through SDLPoP 1.23 (32-bit), your own copy in C:\Games\SDLPoP.
; L3 quicksaves (F6), R3 quickloads (F9), the touchpad is Space (shows the time left).
[application]
id = sdlpop
name = Prince of Persia
executable = C:\Games\SDLPoP\prince.exe
working_directory = C:\Games\SDLPoP
prefix = sdlpop
runtime = wine-wow64
architecture = pe32
graphics = gdi

[display]
desktop = 1920x1080
scaling = fit

[input]
mode = xinput
touchpad = space
r3 = f9
l3 = f6
